#!/usr/bin/env bash
# Wrapper that decrypts Age-encrypted MCP secrets into memory and execs the target MCP server.
# Keeps ~/.gemini/config/mcp_config.json and the filesystem free of plaintext PATs/tokens.

set -euo pipefail

KEY_FILE="${AGY_AGE_KEY_FILE:-$HOME/.config/chezmoi/key.txt}"
SECRETS_FILE="${AGY_MCP_SECRETS_FILE:-$HOME/.config/agy/mcp_secrets.env.age}"

if [ $# -eq 0 ]; then
    echo "Usage: mcp-env-exec <command> [args...]" >&2
    exit 1
fi

if [ -f "$SECRETS_FILE" ]; then
    if [ ! -f "$KEY_FILE" ]; then
        echo "mcp-env-exec: Age identity key not found at $KEY_FILE" >&2
        exit 1
    fi
    set -a
    # shellcheck disable=SC1090
    source <(age -d -i "$KEY_FILE" "$SECRETS_FILE")
    set +a
fi

exec "$@"
