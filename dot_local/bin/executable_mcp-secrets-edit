#!/usr/bin/env bash
# Safely manage Age-encrypted MCP secrets in memory without writing plaintext to disk.
#
# Usage:
#   mcp-secrets-edit                         # Edit secrets interactively in $EDITOR (in /dev/shm RAM disk)
#   mcp-secrets-edit set KEY VALUE           # Set or update a single secret key non-interactively in memory
#   mcp-secrets-edit list                    # List configured secret variable names (values hidden)

set -euo pipefail

KEY_FILE="${AGY_AGE_KEY_FILE:-$HOME/.config/chezmoi/key.txt}"
RECIPIENT="age1n62t5ygs08dtll40g306jttrdnj7ztqcf5yx5cjhszz6dv0ftuasajjw49"
CHEZMOI_SECRETS="$HOME/.local/share/chezmoi/dot_config/agy/private_mcp_secrets.env.age"
RUNTIME_SECRETS="$HOME/.config/agy/mcp_secrets.env.age"

if [ ! -f "$KEY_FILE" ]; then
    echo "Error: Age identity key not found at $KEY_FILE" >&2
    exit 1
fi

decrypt_current() {
    if [ -f "$CHEZMOI_SECRETS" ]; then
        age -d -i "$KEY_FILE" "$CHEZMOI_SECRETS"
    elif [ -f "$RUNTIME_SECRETS" ]; then
        age -d -i "$KEY_FILE" "$RUNTIME_SECRETS"
    else
        cat <<'EOF'
# Antigravity MCP Secrets (Age-encrypted at rest in Git and on disk)
# Format: KEY="value"
# GITHUB_PERSONAL_ACCESS_TOKEN="ghp_..."
# JIRA_API_TOKEN="..."
EOF
    fi
}

save_encrypted() {
    local content="$1"
    mkdir -p "$(dirname "$CHEZMOI_SECRETS")" "$(dirname "$RUNTIME_SECRETS")"
    printf '%s\n' "$content" | age -r "$RECIPIENT" > "$CHEZMOI_SECRETS"
    chmod 600 "$CHEZMOI_SECRETS"
    cp -f "$CHEZMOI_SECRETS" "$RUNTIME_SECRETS"
    chmod 600 "$RUNTIME_SECRETS"
}

cmd="${1:-edit}"

case "$cmd" in
    list)
        decrypt_current | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | cut -d= -f1 || true
        ;;
    set)
        if [ $# -ne 3 ]; then
            echo "Usage: mcp-secrets-edit set <KEY> <VALUE>" >&2
            exit 1
        fi
        key="$2"
        val="$3"
        if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "Error: Invalid environment variable name: $key" >&2
            exit 1
        fi
        existing="$(decrypt_current)"
        filtered="$(printf '%s\n' "$existing" | grep -vE "^(export[[:space:]]+)?${key}=" || true)"
        escaped_val="$(printf '%s' "$val" | sed 's/\\/\\\\/g; s/"/\\"/g')"
        updated="$(printf '%s\n%s="%s"\n' "$filtered" "$key" "$escaped_val")"
        save_encrypted "$updated"
        echo "Updated $key in $CHEZMOI_SECRETS and $RUNTIME_SECRETS"
        ;;
    edit)
        SHM_DIR="/dev/shm"
        [ -d "$SHM_DIR" ] && [ -w "$SHM_DIR" ] || SHM_DIR="/tmp"
        TMP_FILE="$(mktemp "$SHM_DIR/mcp-secrets.XXXXXX")"
        chmod 600 "$TMP_FILE"
        trap 'shred -u "$TMP_FILE" 2>/dev/null || rm -f "$TMP_FILE"' EXIT
        decrypt_current > "$TMP_FILE"
        "${EDITOR:-nano}" "$TMP_FILE"
        save_encrypted "$(cat "$TMP_FILE")"
        echo "Encrypted and saved MCP secrets to $CHEZMOI_SECRETS and $RUNTIME_SECRETS"
        ;;
    *)
        echo "Usage: mcp-secrets-edit [edit | list | set <KEY> <VALUE>]" >&2
        exit 1
        ;;
esac
